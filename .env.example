DB_HOST=localhost
DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

DAJNATO_BASE_URL=/dajnato/
HTML_HEADER_URL=https://trnavka.sk/

DARUJME_API_USERNAME=
DARUJME_API_PASSWORD=
DARUJME_API_KEY=
DARUJME_API_SECRET=
DARUJME_ORGANISATION_ID=

# Shlink — short URLs for links inside parish announcements.
# Leave empty to disable (announcements then keep their plain links, no QR).
SHLINK_URL=https://your-shlink-domain.tld
SHLINK_API_KEY=
# Hosts the local QR endpoint may render codes for (comma-separated).
# Defaults to the SHLINK_URL host when empty; prevents the endpoint being
# abused as an open QR generator for arbitrary URLs.
QR_ALLOWED_DOMAINS=

# Anthropic API key — powers the "suggest announcement heading" button in the
# bulletin editor. Leave empty to hide the button / disable it.
ANTHROPIC_API_KEY=

# API key for the public bulletins/latest JSON endpoint — callers pass it as
# ?api_key=... in the URL. Leave empty to keep the endpoint closed.
BULLETIN_API_KEY=

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
